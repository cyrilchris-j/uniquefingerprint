# ---------------------------------------------------------------------------
# OpenUI Design Registry — environment template
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Nothing in this file is a real credential.
# ---------------------------------------------------------------------------

# --- Public web application (safe to expose, Vite inlines VITE_* at build) ---
VITE_API_BASE_URL=http://localhost:8787
VITE_REGISTRY_BASE_URL=http://localhost:8787/r

# --- Firebase Configuration (Auth & Firestore) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Registry API (server only) --------------------------------------------
# Database connection string (PostgreSQL direct URL or pooling).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Registry artifact publishing ------------------------------------------
REGISTRY_BASE_URL=https://openui.dev/r
# Public base URL of the deployed API (used for absolute URLs in artifacts).
API_BASE_URL=http://localhost:8787

# Name of the registry namespace that `openui init` writes by default.
REGISTRY_DEFAULT_NAMESPACE=default

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# --- Rate limiting ---------------------------------------------------------
# Requests per minute per hashed client identity for public API routes.
RATE_LIMIT_PER_MINUTE=120

# --- Optional: origin allowed to call the API (comma separated) -------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
