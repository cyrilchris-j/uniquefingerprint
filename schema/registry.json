{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://openui.dev/schema/registry.json",
  "title": "OpenUI Registry Index",
  "description": "JSON Schema for the OpenUI registry index.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "registry:component",
              "registry:text",
              "registry:motion",
              "registry:interaction",
              "registry:background",
              "registry:layout",
              "registry:section",
              "registry:block",
              "registry:theme",
              "registry:pattern",
              "registry:template",
              "registry:ai",
              "registry:hook",
              "registry:utility",
              "registry:config",
              "registry:lib",
              "registry:ui",
              "registry:page",
              "registry:file",
              "registry:style",
              "registry:base",
              "registry:font",
              "registry:item"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "registryDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "integrity": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "designSystem": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "dna": {
            "type": "object"
          },
          "subcategory": {
            "type": "string"
          },
          "fingerprint": {
            "type": "object"
          }
        },
        "required": ["name", "type"]
      }
    }
  },
  "required": ["$schema", "name", "items"]
}
