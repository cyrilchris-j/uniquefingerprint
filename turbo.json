{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "GEMINI_API_KEY",
    "CORS_ALLOWED_ORIGINS",
    "API_BASE_URL",
    "REGISTRY_BASE_URL",
    "REGISTRY_ARTIFACTS_DIR",
    "REGISTRY_CACHE_TTL",
    "RATE_LIMIT_PER_MINUTE",
    "LOG_LEVEL",
    "VITE_FIREBASE_API_KEY",
    "VITE_FIREBASE_AUTH_DOMAIN",
    "VITE_FIREBASE_PROJECT_ID",
    "VITE_FIREBASE_STORAGE_BUCKET",
    "VITE_FIREBASE_MESSAGING_SENDER_ID",
    "VITE_FIREBASE_APP_ID",
    "VITE_API_BASE_URL",
    "VITE_REGISTRY_BASE_URL",
    "NODE_ENV",
    "PORT",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@openui/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@openui/registry-api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
