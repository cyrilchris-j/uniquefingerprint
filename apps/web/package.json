    "@openui/registry-client": "workspace:*",
    "@openui/registry-schema": "workspace:*",
    "@openui/search": "workspace:*",
    "@openui/types": "workspace:*",
    "@openui/ui": "workspace:*",
    "@openui/utils": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "firebase": "^12.19.0",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.1",
    "three": "^0.186.0"
