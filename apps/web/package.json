{
  "name": "@openui/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenUI Design Registry — the discovery site: catalogue, resource pages and playground.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
