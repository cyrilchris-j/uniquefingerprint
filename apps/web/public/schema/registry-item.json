{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://uniquefingerprint.web.app/schema/registry-item.json",
  "title": "OpenUI Registry Item",
  "description": "JSON Schema for OpenUI registry item artifacts and definitions.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "The unique kebab-case name of the registry item."
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:component",
        "registry:text",
        "registry:motion",
        "registry:interaction",
        "registry:background",
        "registry:layout",
        "registry:section",
        "registry:block",
        "registry:theme",
        "registry:pattern",
        "registry:template",
        "registry:ai",
        "registry:hook",
        "registry:utility",
        "registry:config",
        "registry:lib",
        "registry:ui",
        "registry:page",
        "registry:file",
        "registry:style",
        "registry:base",
        "registry:font",
        "registry:item"
      ],
      "description": "The type of resource in the OpenUI registry."
    },
    "title": {
      "type": "string",
      "description": "Human-readable display title."
    },
    "description": {
      "type": "string",
      "description": "Detailed explanation of the resource purpose and design."
    },
    "category": {
      "type": "string"
    },
    "resourceType": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "devDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "contentHash": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "target": {
            "type": "string"
          }
        },
        "required": ["path"]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string"
    },
    "integrity": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "designSystem": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    },
    "dna": {
      "type": "object"
    },
    "fingerprint": {
      "type": "object"
    },
    "designRules": {
      "type": "string"
    }
  },
  "required": ["name", "type"]
}
