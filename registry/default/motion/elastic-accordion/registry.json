      "path": "elastic-accordion.tsx",
      "type": "registry:motion"
    }
  ],
  "tags": [
    "accordion",
    "elastic",
    "overshoot",
    "slinky"
  ],
  "license": "MIT",
  "meta": {
    "difficulty": "advanced",
    "subcategory": "physics",
    "fingerprint": {
