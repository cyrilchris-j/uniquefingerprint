{
  "$schema": "../../../../schema/registry-item.json",
  "name": "dock-navigation",
  "type": "registry:component",
  "title": "Dock Navigation",
  "description": "A macOS-style navigation dock that magnifies icons by pointer distance with a falloff curve, magnification driven by one rAF-throttled pointermove and disabled on touch and reduced motion.",
  "category": "components",
  "dependencies": [
    "react",
    "lucide-react"
  ],
  "registryDependencies": [
    "cn"
  ],
  "files": [
    {
      "path": "dock-navigation.tsx",
      "type": "registry:component"
    }
  ],
  "tags": [
    "navigation",
    "dock",
    "pointer",
    "magnify"
  ],
  "license": "MIT",
  "meta": {
    "difficulty": "intermediate",
    "subcategory": "navigation",
    "fingerprint": {
      "interactionModel": "pointer-proximity-scale",
      "visualModel": "icon-rail",
      "motionModel": "distance-falloff",
      "layoutModel": "bottom-dock",
      "semanticPurpose": "primary-navigation"
    },
    "features": [
      "keyboard-accessible",
      "reduced-motion-safe",
      "responsive"
    ],
    "peer": {
      "react": ">=19"
    },
    "dna": {
      "genre": "playful",
      "macrostructure": "rail",
      "density": "compact",
      "shapeLanguage": "soft",
      "motionLanguage": "expressive",
      "typographyStyle": "grotesk",
      "colorStrategy": "duotone"
    }
  }
}
