{
  "$schema": "../../../../schema/registry-item.json",
  "name": "use-in-view",
  "type": "registry:hook",
  "title": "Use In View",
  "description": "An IntersectionObserver hook with once-mode for lazy activation, automatic disconnect on unmount, and a pre-mount false so SSR and hydration agree.",
  "category": "components",
  "dependencies": ["react"],
  "registryDependencies": [],
  "files": [
    {
      "path": "use-in-view.ts",
      "type": "registry:hook",
      "target": "hooks"
    }
  ],
  "tags": ["hook", "intersection-observer", "performance"],
  "license": "MIT",
  "meta": {
    "difficulty": "starter",
    "subcategory": "hooks",
    "fingerprint": {
      "interactionModel": "visibility-observer",
      "visualModel": "none",
      "motionModel": "none",
      "layoutModel": "inline",
      "semanticPurpose": "lazy-activation"
    },
    "features": ["zero-dependency", "ssr-safe"]
  }
}
